# ── LiveKit (транспорт звука) ──────────────────────────────
# Для локального docker-compose значения уже проставлены в compose-файле.
# Для LiveKit Cloud — возьми из панели проекта.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── OpenAI (распознавание речи + «мозг») ───────────────────
# Запросить у команды. Нужен доступ к моделям STT и LLM.
OPENAI_API_KEY=

# ── ElevenLabs (голос) ─────────────────────────────────────
# Запросить у команды: ключ и ID записанного голоса компании.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Модель TTS: multilingual_v2 стабильнее по тону; turbo/flash — быстрее, но менее ровно.
ELEVENLABS_MODEL=eleven_multilingual_v2
# альтернативы: eleven_turbo_v2_5 (быстрее) или eleven_flash_v2_5 (ещё быстрее, менее стабильно)
# Настройки тона (опционально; дефолты уже ровные для делового звонка):
# ELEVENLABS_STABILITY=0.7    # ровный тон, меньше скачков интонации
# ELEVENLABS_SIMILARITY=0.8   # строго держать исходный голос
# ELEVENLABS_STYLE=0.0        # без добавленной экспрессии

# ── Необязательное (можно не трогать) ──────────────────────
VOICE_BOT_LANGUAGE=ru
VOICE_BOT_LLM_MODEL=gpt-4.1-mini
VOICE_BOT_STT_MODEL=gpt-4o-mini-transcribe
VOICE_BOT_AGENT_NAME=voice-bot
# true — автоподхват комнат (локальные тесты); в проде false + явный dispatch.
AGENT_AUTO_ACCEPT=true
VOICE_BOT_SCENARIO=vector_ru
# Уровень логов проекта: INFO — рабочий, DEBUG — для разбора проблем.
VOICE_BOT_LOG_LEVEL=INFO
# Уровень шумных библиотек: WARNING — только проблемы.
VOICE_BOT_NOISY_LOG_LEVEL=WARNING

# --- Распознавание речи -------------------------------------
# service — локальный транскрибатор по HTTP; openai — облако через прокси.
VOICE_BOT_STT_PROVIDER=service
# Сервис распознавания поднят отдельным стеком, общей docker-сети нет.
# 172.17.0.1 — шлюз docker-моста на Linux. Если подсеть нестандартная,
# посмотри `ip addr show docker0`, либо укажи внутренний IP сервера.
VOICE_BOT_STT_SERVICE_URL=http://172.17.0.1:8137
# Сколько ждать ответа сервиса на одну реплику, секунды.
VOICE_BOT_STT_SERVICE_TIMEOUT=15

# --- «Мозг» (LLM) -------------------------------------------
# openai — облачная модель (поведение по умолчанию);
# agent — удалённый граф на LangGraph Server (отдельный стек).
# VOICE_BOT_LLM_PROVIDER=openai
# Базовый URL агентского сервиса (нужен только при provider=agent).
# VOICE_BOT_AGENT_URL=http://172.17.0.1:8127
# Имя графа из langgraph.json агентского сервиса.
# VOICE_BOT_AGENT_GRAPH=vector_agent
# Таймаут HTTP до графа, секунды (стрим на весь ход разговора).
# VOICE_BOT_AGENT_TIMEOUT=30
# Стратегия multitask основного хода (точка расширения; пока плагин
# LiveKit её не пробрасывает — оставлять пустым).
# VOICE_BOT_AGENT_MAIN_MULTITASK=

# --- Живой режим (служебный граф vector_checker) -------------
# true — живой режим: чекер + контекстер работают, пока клиент говорит
# (прогрев вперёд по накопленному STT). В коде дефолт false (безопасно).
VOICE_BOT_AGENT_PARTIAL_ENABLED=true
# URL LangGraph-сервера агента (вторая точка входа; обычно совпадает с AGENT_URL).
VOICE_BOT_AGENT_PARTIAL_URL=http://172.17.0.1:8127
# Имя служебного графа из langgraph.json агента.
VOICE_BOT_AGENT_PARTIAL_GRAPH=vector_checker
# Таймаут HTTP на постановку фонового run, секунды.
# VOICE_BOT_AGENT_PARTIAL_TIMEOUT=5

# ── Прокси (опционально; нужен, если ElevenLabs/OpenAI блокируются по региону) ──
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=

# ── Фоновый звук (офисный эмбиент + клавиатура, когда агент «думает») ──
# BG_ENABLED=true
# BG_AMBIENT_VOLUME=0.4    # офисный фон; 0.3–0.5 обычно ок, выше может мешать голосу
# BG_THINKING_VOLUME=0.6   # громкость клавиатуры в паузах перед ответом
